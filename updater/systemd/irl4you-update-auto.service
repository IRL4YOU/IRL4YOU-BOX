[Unit]
Description=IRL4YOU Update (regelmäßige Prüfung)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/irl4you-update auto
TimeoutStartSec=1h
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
# Abgelehnte Abfrage (z. B. GitHub bremst, Exit 2) ist kein Dienstfehler: nicht als "fehlgeschlagen" anzeigen
SuccessExitStatus=2
